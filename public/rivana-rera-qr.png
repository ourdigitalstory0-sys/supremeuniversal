<script src=" https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.min.js "></script>
<script src="https://www.supremeuniversal.com/front/js/custom.js?v=211319"></script>

<script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/intl-tel-input@25.2.1/build/css/intlTelInput.css">
<script src="https://cdn.jsdelivr.net/npm/intl-tel-input@25.2.1/build/js/intlTelInput.min.js"></script>

<script>

    ScrollTrigger.create({
        start: 100,
        end: 99999,
        toggleClass: { targets: ".fixedEnquireBtn", className: "scrolled" }
    });

    $(document).ready(function () {
        $(".nav__dropdown__menu__item.active").each(function () {
            $(this).closest(".nav__dropdown__menu").css("display", "block");

            $(this).closest(".nav__dropdown__menu").prev(".nav__dropdown").addClass("active");
        });
    });

    $(document).ajaxStart(function(){
        // Show image container
        $(".loader").css('display', "flex");
    });

    $(document).ajaxComplete(function(){
        // Hide image container
        $(".loader").fadeOut('slow');
    });

    function displayErrors(errors) {
        // Clear previous errors
        for (let field in errors) {
            let errorElement = document.getElementById(`${field}_error`);
            if (errorElement) {
                errorElement.innerHTML = '';
            }
        }

        // Display errors for each field
        for (let field in errors) {
            if (errors[field]) {
                let errorElement = document.getElementById(`${field}_error`);
                if (errorElement) {
                    let errorList = errors[field].map(error => `<li>${error}</li>`).join('');
                    errorElement.innerHTML = `<ul>${errorList}</ul>`;
                }
            }
        }
    }

    function getQueryParam(name) {
        const urlParams = new URLSearchParams(window.location.search);
        return urlParams.get(name);
    }

    // List of UTM parameters and tracking IDs
    const params = ['crm_source', 'crm_campaign', 'utm_id', 'utm_source', 'utm_medium', 'utm_campaign', 'utm_term', 'utm_content', 'gclid', 'fbclid'];

    // Collect UTM parameters from GET request
    let utmData = {};
    params.forEach(param => {
        const value = getQueryParam(param);
        if (value) {
            utmData[param] = value;
        }
    });
</script>


    <script>
    
        $('#newsletters_form_submit').parsley().on('field:validated', function() {
            var ok = $('.parsley-error').length === 0;
            $('.bs-callout-info').toggleClass('hidden', !ok);
            $('.bs-callout-warning').toggleClass('hidden', ok);
        })
        .on('form:submit', function() {
            var formData = new FormData($("#newsletters_form_submit")[0]);
            var url = 'https://www.supremeuniversal.com/newsletters';

            $('#newsletters_form_submit').find('.error').html('');

            $.ajax({
                type: "POST",
                dataType: "json",
                url: url,
                data: formData,
                //async: false,
                global : true,
                cache: false,
                contentType: false,
                processData: false,
                beforeSend:function(){
                },
                success: function(result) {

                    if(result["status"] === false){
                        
                        if(result['errors']){
                            displayErrors(result['errors']);
                        }else{
                            $("#newsletter_email_error").html(result["message"]);
                        }
                    }else{

                        $("#newsletters_form_submit")[0].reset();
                        $("#email_success").html(result["message"]);

                    }
                },
                error: function() {
                    $("#newsletter_email_error").html("Failed to perform this action.");
                }
            });
        });
    </script>


<script>
    const contact_input = document.querySelector("#contact_mobile_number");
    if(contact_input != null){
        const contact_iti = window.intlTelInput(contact_input, {
            loadUtils: () =>
            import(
                "https://cdnjs.cloudflare.com/ajax/libs/intl-tel-input/23.0.4/js/utils.min.js"
            ),
            initialCountry: "in",
            placeholderNumberType: "",
            separateDialCode: true,
        });
    
        contact_input.addEventListener('input', function() {
            const formattedNumber = contact_iti.getNumber();
            var unformattedNumber = stripFormatting(formattedNumber);
            const countryCode = contact_iti.getSelectedCountryData().dialCode;
            if (unformattedNumber.startsWith(countryCode)) {
                unformattedNumber = unformattedNumber.slice(countryCode.length);
            }
            contact_input.value = unformattedNumber;
        });
    
        window.Parsley.addValidator('cphone', {
            validateString: function(value, requirement, instance) {
                return contact_iti.isValidNumberPrecise() && !value.startsWith('0');
            },
            messages: {
                en: 'Please enter a valid phone number with country code.'
            }
        });
    
        function stripFormatting(number) {
            return number.replace(/[^\d]/g, '');
        }
    
        $('#contact_form_submit').parsley().on('field:validated', function() {
            var ok = $('.parsley-error').length === 0;
            $('.bs-callout-info').toggleClass('hidden', !ok);
            $('.bs-callout-warning').toggleClass('hidden', ok);
        })
        .on('form:submit', function() {
            var formData = new FormData($("#contact_form_submit")[0]);
            var url = 'https://www.supremeuniversal.com/contact-submit';
    
            $('#contact_form_submit').find('.error').html('');
    
            var country_code = '+'+contact_iti.getSelectedCountryData().dialCode;
            formData.append("country_code", country_code);
    
            // Append all UTM parameters to FormData
            Object.keys(utmData).forEach(key => {
                formData.append(key, utmData[key]);
            });
    
            $.ajax({
                type: "POST",
                dataType: "json",
                url: url,
                data: formData,
                //async: false,
                global: true,
                cache: false,
                contentType: false,
                processData: false,
                beforeSend:function(){
                },
                success: function(result) {
    
                    if(result["status"] === false){
                        
                        if(result['errors']){
                            displayErrors(result['errors']);
                        }else{
                            $("#contact_form_error").html(result["message"]);
                        }
                    }else{
    
                        $("#contact_form_submit")[0].reset();
                        $("#contact_form_success").html(result["message"]);
                        gsap.to(".projectEnquierPopUp .offcanvas-body", { duration: 0, scrollTo: { y: "max" }});
                    }
                },
                error: function() {
                    $("#contact_form_error").html("Failed to perform this action.");
                }
            });
        });
        
    }

    $(".whatsapp svg").on("click", function(){
        $(".whatsapp").toggleClass("active");
    });

</script>




    <script>
        
        $(window).on("load", function(){
            var url = 'https://wati-integration-prod-service.clare.ai/v2/watiWidget.js?61857';
            var s = document.createElement('script');
            s.type = 'text/javascript';
            s.async = true;
            s.src = url;
            let bottomMargin = 20;

            if (window.matchMedia("(max-width: 768px)").matches) {
                bottomMargin = 58;
            }

            setTimeout(() => {
                var options = {
                    "enabled": true,
                    "chatButtonSetting": {
                    "backgroundColor": "#25D366",
                    "borderRadius": "25",
                    "marginLeft": "0",
                    "marginRight": "34",
                    "marginBottom": bottomMargin,
                    "ctaIconWATI": false,
                    "position": "right"
                    },
                    "brandSetting": {
                    "brandName": "Supreme Universal",
                    "brandSubTitle": "undefined",
                    "brandImg": "https://supreme.360enrich.io/files/supreme_universal_logo.png",
                    "welcomeText": "Hi there!\nType Hello to chat with us!",
                    "messageText": "Hello",
                    "backgroundColor": "#25D366",
                    "ctaText": "Chat with us",
                    "borderRadius": "25",
                    "autoShow": false,
                    "phoneNumber": "919860468487"
                    }
                    };
                    s.onload = function () {
                    CreateWhatsappChatWidget(options);
                    };
                    var x = document.getElementsByTagName('script')[0];
                    x.parentNode.insertBefore(s, x);
            }, 1500);
        });

    </script>   

        
                    <script>
                let check = localStorage.getItem("disclaimerShown");
                if (!check) {
                    setTimeout(() => {
                        $('.disclaimerModal').modal('show');
                    }, 1500);
                }

                $(".disclaimerModal .lineBtn").click(function (e) {
                    e.preventDefault();
                    $('.disclaimerModal').modal('hide');
                    localStorage.setItem("disclaimerShown", "true");
                });
                
            </script>
            
</body>

